[
  {
    "id": "deye-v5-test-tab",
    "type": "tab",
    "label": "Deye V5 Test Suite",
    "disabled": false,
    "info": "Safe read-only test suite demonstrating Built-in Presets (smoke, rtc), Message-Driven Reads (msg.payload = 'bms' or { startAddress, registerCount }), FIFO job pacing, 2nd-output error routing, and 3rd-output dongle stats."
  },
  {
    "id": "deye-v5-test-cfg",
    "type": "deye-solarman-config",
    "name": "Deye Hybrid Dongle (Test)",
    "host": "192.168.1.120",
    "port": 8899,
    "loggerSn": "2712345678",
    "unitId": 1,
    "timeout": 3000,
    "retries": 1,
    "series": "SG01HP3"
  },
  {
    "id": "test-smoke-inject",
    "type": "inject",
    "z": "deye-v5-test-tab",
    "name": "1. Run Telemetry Smoke Test",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "test/smoke",
    "payload": "",
    "payloadType": "date",
    "x": 180,
    "y": 80,
    "wires": [["test-smoke-read"]]
  },
  {
    "id": "test-smoke-read",
    "type": "deye-solarman-read",
    "z": "deye-v5-test-tab",
    "name": "Read Core Telemetry (Preset: smoke)",
    "dongle": "deye-v5-test-cfg",
    "requestMode": "preset",
    "preset": "smoke",
    "allowMsgOverride": true,
    "queueMode": "fifo",
    "maxQueue": 10,
    "paceMs": 250,
    "blockDelayMs": 50,
    "registers": [],
    "blocks": [],
    "x": 460,
    "y": 80,
    "wires": [["test-smoke-validate"], ["test-read-error-debug"], ["test-read-stats-debug"]]
  },
  {
    "id": "test-smoke-validate",
    "type": "function",
    "z": "deye-v5-test-tab",
    "name": "Assert Valid Values",
    "func": "const data = msg.payload || {};\nconst keys = Object.keys(data).filter((k) => k !== 'raw');\nconst missing = keys.filter((k) => data[k] === null || data[k] === undefined);\nmsg.payload = {\n  pass: keys.length > 0 && missing.length === 0,\n  fieldsReceived: keys.length,\n  missing,\n  telemetry: data,\n  solarman: msg.solarman\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 730,
    "y": 80,
    "wires": [["test-smoke-debug"]]
  },
  {
    "id": "test-smoke-debug",
    "type": "debug",
    "z": "deye-v5-test-tab",
    "name": "Smoke Test Result",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload.pass",
    "statusType": "msg",
    "x": 960,
    "y": 80,
    "wires": []
  },
  {
    "id": "test-rtc-inject",
